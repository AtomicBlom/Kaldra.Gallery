<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- Shared shader-build props (defines KaldraShaderIncludeDir = BinaryVibrance.Kaldra.Shaders/Shaders for the platform module). -->
  <Import Project="$(KaldraSource)build\BinaryVibrance.Kaldra.Sdk\Kaldra.Shaders.props" />

  <!-- XAML → typed control-tree generator: registers UI/*.xaml as AdditionalFiles + the BinaryVibrance.Vysara.SourceGen analyzer,
       so the interactive UI demo's page compiles to a typed tree + x:Bind/event glue (same wiring as the sandbox). -->
  <Import Project="$(VysaraSource)build\Vysara.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Marks the browser build so demo source shared (linked) from the sandbox can compile out the few desktop-only
         bits — chiefly the Dear ImGui debug panels, whose native library the browser build doesn't reference. -->
    <DefineConstants>$(DefineConstants);KALDRA_WEB</DefineConstants>
    <!-- Drop the ICU database: the demos and Vysara text do no culture-sensitive formatting, so invariant mode is
         behaviourally identical here and saves the multi-hundred-KB ICU payload. Set unconditionally so a debug run
         behaves the same as the shipped build. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Release/publish shipping build: compile the engine + demo hot paths to native WebAssembly (the Mono interpreter
       stays as the fallback for anything AOT can't cover) for game-grade frame times, and relink the runtime with the
       unused ICALL/managed surface stripped. AOT roughly doubles the .wasm download but is the lever that makes the
       real render loop fast; keep it off for debug builds so the inner-loop build stays quick. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Hand-ported demos reuse the sandbox's shaders verbatim, compiled to WGSL and embedded under
         "Kaldra.Web.Shaders." (the host's ShaderResolver resolves them). Only WGSL is needed in the browser. -->
    <KaldraShaderSourceDir>$(MSBuildProjectDirectory)\..\Kaldra.Gallery\Shaders</KaldraShaderSourceDir>
    <KaldraShaderOutputMode>Embed</KaldraShaderOutputMode>
    <KaldraEmitDxil>false</KaldraEmitDxil>
    <KaldraEmitWgsl>true</KaldraEmitWgsl>
  </PropertyGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <!-- The browser host references the WebGPU backend (and, transitively, the neutral engine layers). All are
       pure-managed net10.0 assemblies, so they link into the WASM app unchanged. -->
  <ItemGroup>
    <ProjectReference Include="$(KaldraSource)BinaryVibrance.Kaldra.Backend.WebGPU\BinaryVibrance.Kaldra.Backend.WebGPU.csproj" />
    <ProjectReference Include="$(KaldraSource)BinaryVibrance.Kaldra.Core\BinaryVibrance.Kaldra.Core.csproj" />
    <ProjectReference Include="$(KaldraSource)BinaryVibrance.Kaldra.Graph\BinaryVibrance.Kaldra.Graph.csproj" />
    <ProjectReference Include="$(KaldraSource)BinaryVibrance.Kaldra.Assets\BinaryVibrance.Kaldra.Assets.csproj" />
    <ProjectReference Include="$(KaldraSource)BinaryVibrance.Kaldra.Concepts\BinaryVibrance.Kaldra.Concepts.csproj" />
    <!-- The demos name the app-side helpers as Concepts.Camera, Concepts.Scene, apart from the engine's own -->
    <Using Include="BinaryVibrance.Kaldra.Concepts" Alias="Concepts" />
    <!-- The Vysara UI runtime (retained control tree + compositor, NativeAOT-clean, pure managed) and its
         backend-neutral engine bridge (UIPainter, public-API-only). Both link into the WASM app unchanged, so the
         browser drives a real UIHost exactly as the desktop sandbox does. -->
    <ProjectReference Include="$(KaldraSource)BinaryVibrance.Kaldra.UI.Vysara\BinaryVibrance.Kaldra.UI.Vysara.csproj" />
    <ProjectReference Include="$(VysaraSource)BinaryVibrance.Vysara\BinaryVibrance.Vysara.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The game-UI shader lives with its integration (BinaryVibrance.Kaldra.UI.Vysara/Shaders); pull it into this app's WGSL
         emission so it embeds as "Kaldra.Web.Shaders.ui.wgsl" beside the demo shaders. It resolves the same
         kaldra_platform.module.slang include the sandbox shaders do (KaldraShaderIncludeDir is already set). -->
    <KaldraSlangEntry Include="$(KaldraSource)BinaryVibrance.Kaldra.UI.Vysara\Shaders\ui.slang" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reusable graph fragments the sandbox authors — shared verbatim by linking (not copying) the source, so the
         browser demos can't drift from the desktop originals. These are pure BinaryVibrance.Kaldra.Core/Graph code (no host coupling),
         so they compile into the WASM assembly unchanged under their own Kaldra.Gallery.Demos namespace. -->
    <Compile Include="..\Kaldra.Gallery\Demos\BloomGraph.cs" Link="Demos\Shared\BloomGraph.cs" />
    <Compile Include="..\Kaldra.Gallery\Cascades.cs" Link="Demos\Shared\Cascades.cs" />
    <Compile Include="..\Kaldra.Gallery\DayNight.cs" Link="Demos\Shared\DayNight.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\DemoSun.cs" Link="Demos\Shared\DemoSun.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\SandboxVertexLayouts.cs" Link="Demos\Shared\SandboxVertexLayouts.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\SpriteInstance.cs" Link="Demos\Shared\SpriteInstance.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\Light2DInstance.cs" Link="Demos\Shared\Light2DInstance.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\BallAtlas.cs" Link="Demos\Shared\BallAtlas.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\SpinnerAtlas.cs" Link="Demos\Shared\SpinnerAtlas.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\SparkAtlas.cs" Link="Demos\Shared\SparkAtlas.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\TileAtlas.cs" Link="Demos\Shared\TileAtlas.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\CastleBackdrop.cs" Link="Demos\Shared\CastleBackdrop.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\GuardKnight.cs" Link="Demos\Shared\GuardKnight.cs" />
    <!-- The demo scaffolding shared with the sandbox: the shared-resource carrier, geometry builders, the per-draw
         uniform block, the mesh-draw helper, and the graph helpers (its Dear ImGui HUD is #if'd out for the browser). -->
    <Compile Include="..\Kaldra.Gallery\Demos\IDemo.cs" Link="Demos\Shared\IDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\DemoScene.cs" Link="Demos\Shared\DemoScene.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\DemoCamera.cs" Link="Demos\Shared\DemoCamera.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\Geometry.cs" Link="Demos\Shared\Geometry.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\PerDraw.cs" Link="Demos\Shared\PerDraw.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\DemoDraw.cs" Link="Demos\Shared\DemoDraw.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\DemoGraph.cs" Link="Demos\Shared\DemoGraph.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\DebugSlider.cs" Link="Demos\Shared\DebugSlider.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\DemoShell.cs" Link="Demos\Shared\DemoShell.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- A XAML page shared verbatim with the sandbox: its code-behind linked like the demos, and its markup handed to
         the BinaryVibrance.Vysara.SourceGen generator as one more AdditionalFile (Vysara.targets only globs this project's own folder),
         so both hosts compile the same Kaldra.Gallery.UI.VectorUIView. -->
    <Compile Include="..\Kaldra.Gallery\UI\VectorUIView.cs" Link="UI\Shared\VectorUIView.cs" />
    <AdditionalFiles Include="..\Kaldra.Gallery\UI\VectorUIView.xaml" Link="UI\Shared\VectorUIView.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- The demos themselves, shared verbatim with the sandbox (one IDemo per file). The browser host (Program.cs,
         WebGallery) drives them exactly as the desktop launcher does; ImGui debug panels are #if'd out for the browser
         and asset loads route through DemoScene.Asset (embedded resources here, files on desktop). -->
    <Compile Include="..\Kaldra.Gallery\Demos\CubeLightingDemo.cs" Link="Demos\CubeLightingDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\ParticlesDemo.cs" Link="Demos\ParticlesDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\MsaaDemo.cs" Link="Demos\MsaaDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\StorageScatterDemo.cs" Link="Demos\StorageScatterDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\HighlightingDemo.cs" Link="Demos\HighlightingDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\BloomDemo.cs" Link="Demos\BloomDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\TonemappingDemo.cs" Link="Demos\TonemappingDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\SsaoDemo.cs" Link="Demos\SsaoDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\CascadedShadowsDemo.cs" Link="Demos\CascadedShadowsDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\SkinningDemo.cs" Link="Demos\SkinningDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\GltfDemo.cs" Link="Demos\GltfDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\UIInteractiveDemo.cs" Link="Demos\UIInteractiveDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\UIGroupOpacityDemo.cs" Link="Demos\UIGroupOpacityDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\FullReferenceDemo.cs" Link="Demos\FullReferenceDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\InWorldUIDemo.cs" Link="Demos\InWorldUIDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\VectorPrimsDemo.cs" Link="Demos\VectorPrimsDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\VectorUIDemo.cs" Link="Demos\VectorUIDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\UILiveTextureDemo.cs" Link="Demos\UILiveTextureDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\Debug2DDemo.cs" Link="Demos\Debug2DDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\FoliageDemo.cs" Link="Demos\FoliageDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\InstancingDemo.cs" Link="Demos\InstancingDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\Lighting2DDemo.cs" Link="Demos\Lighting2DDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\NightGladeDemo.cs" Link="Demos\NightGladeDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\NormalMappingDemo.cs" Link="Demos\NormalMappingDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\ParallaxDemo.cs" Link="Demos\ParallaxDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\PixelArtCastleDemo.cs" Link="Demos\PixelArtCastleDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\PixelArtDemo.cs" Link="Demos\PixelArtDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\RuinsDemo.cs" Link="Demos\RuinsDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\ShadowsDemo.cs" Link="Demos\ShadowsDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\SkyDayNightDemo.cs" Link="Demos\SkyDayNightDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\SpikeDemo.cs" Link="Demos\SpikeDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\SpriteAnimationDemo.cs" Link="Demos\SpriteAnimationDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\SpritesDemo.cs" Link="Demos\SpritesDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\StylizedDemo.cs" Link="Demos\StylizedDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\TilemapDemo.cs" Link="Demos\TilemapDemo.cs" />
    <Compile Include="..\Kaldra.Gallery\Demos\ToonDemo.cs" Link="Demos\ToonDemo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Demo assets served as real static files (fetch()'d by WebAssets.LoadAsync over HTTP), not embedded
         resources — copied from the sandbox's committed Assets folder into this project's wwwroot/assets/ at build
         time (LinkBase preserves the relative path, so e.g. kenney/castle/wall.glb lands at
         wwwroot/assets/kenney/castle/wall.glb) rather than duplicating the binary assets into this project. -->
    <Content Include="..\Kaldra.Gallery\Assets\**" LinkBase="wwwroot\assets\" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hermetic slangc for compiling the demo shaders to WGSL (build-machine only). -->
    <PackageReference Include="Slang.Sdk" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="compile;runtime" />
    <!-- Source-gen MVVM for the demo shell's per-demo debug panels (shared with the sandbox via linked demo files). -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <Import Project="$(KaldraSource)build\BinaryVibrance.Kaldra.Sdk\Kaldra.Shaders.targets" />

  <!-- Registers UI/*.xaml as AdditionalFiles for the BinaryVibrance.Vysara.SourceGen analyzer (imported after the body so the
       source dir is set). -->
  <Import Project="$(VysaraSource)build\Vysara.targets" />

</Project>
