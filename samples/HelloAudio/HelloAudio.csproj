<Project>

  <!--
    One project, three deployables:
        dotnet build -f net10.0                                 → a native Vulkan desktop exe (SDL 3 audio)
        dotnet build -f net11.0-android                         → an Android APK (Vulkan, AAudio, touch)
        dotnet publish -f net10.0 -r browser-wasm               → a WebGPU browser app (an AudioWorklet)
    A bare <Project> (no outer Sdk= attribute): BinaryVibrance.Kaldra.Sdk's own Sdk.props/Sdk.targets (imported below) choose and
    import the real base SDK by target, pull in the matching backend and application host, and pick how the shaders
    ship (loose beside the desktop exe, embedded for the browser and the APK). The app itself (AudioApp, PolySynth) is
    the same source on all three; only the entry point differs: Platforms/Desktop/Program.cs (the desktop and the
    browser), or the activity in Platforms/Android.
    Kept out of BinaryVibrance.Kaldra.slnx (in HelloAudio.slnx and BinaryVibrance.Kaldra.Android.slnx) so the desktop build never needs the android
    workload.
  -->

  <!-- Before the SDK props: Kaldra.Shaders.props derives which shader targets to emit from these. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <UseVulkan>false</UseVulkan>
    <UseDirectX12>false</UseDirectX12>
    <UseWebGPU>true</UseWebGPU>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm'">
    <UseVulkan>true</UseVulkan>
    <UseDirectX12>false</UseDirectX12>
    <UseWebGPU>false</UseWebGPU>
  </PropertyGroup>

  <!-- Where the engine and the audio come from (build/Sources.props), before Kaldra's SDK, which is the engine's -->
  <Import Project="..\..\build\Sources.props" />
  <Import Project="$(KaldraSource)build\BinaryVibrance.Kaldra.Sdk\Sdk\Sdk.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0;net11.0-android</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HelloAudio</RootNamespace>
    <KaldraShaderSourceDir>$(MSBuildProjectDirectory)\Shaders</KaldraShaderSourceDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <ApplicationId>com.atomicblom.kaldra.helloaudio</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- arm64 for phones; x64 for an emulator on an x64 machine. -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidManifest>Platforms\Android\AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm' and '$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
  </PropertyGroup>

  <!-- Each target compiles its own entry point only. -->
  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">
    <Compile Remove="Platforms\Desktop\**" />
  </ItemGroup>
  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' != 'android'">
    <Compile Remove="Platforms\Android\**" />
    <None Remove="Platforms\Android\**" />
  </ItemGroup>

  <!-- The audio: Sirrow is apart from the engine, so the app takes the output for each of its platforms itself, and
       its entry points register the one they run on. The desktop's and the browser's share an entry point, so both
       come with every target but Android's. -->
  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">
    <ProjectReference Include="$(SirrowSource)BinaryVibrance.Sirrow.Android\BinaryVibrance.Sirrow.Android.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' != 'android'">
    <ProjectReference Include="$(SirrowSource)BinaryVibrance.Sirrow.Sdl\BinaryVibrance.Sirrow.Sdl.csproj" />
    <ProjectReference Include="$(SirrowSource)BinaryVibrance.Sirrow.Web\BinaryVibrance.Sirrow.Web.csproj" />
  </ItemGroup>

  <Import Project="$(KaldraSource)build\BinaryVibrance.Kaldra.Sdk\Sdk\Sdk.targets" />

</Project>
