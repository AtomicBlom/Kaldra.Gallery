<Border xmlns="https://github.com/AtomicBlom/Loom/ui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Loom.Sandbox.UI.UIInteractiveView"
        HorizontalAlignment="Left" VerticalAlignment="Top"
        Width="360" Height="190" CornerRadius="16">
	<StackPanel Orientation="Vertical">
		<Button x:Name="ActionButton" HorizontalAlignment="Left" Width="200" Height="56"
		        Content="Click me" Click="{x:Bind OnButtonClick}" />
		<TextBlock x:Name="StatusLabel" FontSize="24" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
	</StackPanel>
</Border>
