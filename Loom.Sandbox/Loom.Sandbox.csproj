<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Loom MSBuild SDK: adds the backend reference(s) for this build (UseVulkan/UseDirectX12) and the desktop
       host, and generates the module-initializer bootstrap that registers them — so this exe is just a
       LoomApplication + one LoomApplication.Run line. The engine feature flags live in the repo-root
       Directory.Build.props. -->
  <Import Project="..\build\Loom.Sdk\Sdk\Sdk.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The host builds the dev HUD and hands the executor ImGui's native ImDrawData* each frame — one pointer cast. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The gallery owns the shaders + assets now; this exe compiles none of its own — they flow in beside the exe
         through the Loom.Gallery ProjectReference. -->
    <LoomShaderOutputMode>None</LoomShaderOutputMode>
    <!-- Both UI bridges, through the SDK flags rather than by hand — which also keeps them honest: they are
         documented in the SDK README and getting-started, so the sandbox building on them is the test that they
         do something. -->
    <UseSUIsei>true</UseSUIsei>
    <UseImGui>true</UseImGui>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dear ImGui bindings (native cimgui bundled, incl. win-arm64) — the sandbox builds the dev control panel; the
         optional Loom.UI.ImGui bridge renders it through the public draw-list API (no backend ImGui dependency). -->
    <PackageReference Include="ImGui.NET" />
  </ItemGroup>

  <ItemGroup>
    <!-- The demo gallery (demos + their shaders/assets/UI views); the sandbox is its interactive host. -->
    <ProjectReference Include="..\Loom.Gallery\Loom.Gallery.csproj" />
    <!-- The engine-tier libraries the host itself names: the neutral asset loaders (brick material), the app-side
         camera/frustum helpers, the SUIsei UI runtime + its neutral engine bridge, and the ImGui HUD bridge. The
         desktop host + backend(s) come from the Loom SDK above. -->
    <ProjectReference Include="..\Loom.Assets\Loom.Assets.csproj" />
    <ProjectReference Include="..\Loom.Concepts\Loom.Concepts.csproj" />
    <ProjectReference Include="..\external\SUIsei\SUIsei\SUIsei.csproj" />
  </ItemGroup>

  <Import Project="..\build\Loom.Sdk\Sdk\Sdk.targets" />

</Project>
