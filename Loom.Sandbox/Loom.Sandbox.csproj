<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The host hands the executor ImGui's native ImDrawData* each frame — one pointer cast. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loom.Vulkan\Loom.Vulkan.csproj" />
    <!-- Brings the compiled .spv into the app output under shaders\ (no code dependency). -->
    <ProjectReference Include="..\Loom.Shaders\Loom.Shaders.csproj" />
  </ItemGroup>

  <!-- The host owns the window + input and hands the backend the surface. -->
  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <!-- Dear ImGui bindings (native cimgui bundled, incl. win-arm64) — the host builds the control panel. -->
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

</Project>
