<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/AtomicBlom/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="AtomicBlom" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github>
  </packageSourceCredentials>
  <!-- CPM + multiple sources requires source mapping (NU1507). All third-party packages come from
       nuget.org; AtomicBlom packages (Kaldra, Vysara) come from GitHub Packages. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Kaldra" />
      <package pattern="Kaldra.*" />
      <package pattern="BinaryVibrance.Vysara" />
      <package pattern="Vysara.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
