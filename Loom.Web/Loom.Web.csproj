<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- Shared shader-build props (defines LoomShaderIncludeDir = Loom.Shaders/Shaders for the platform module). -->
  <Import Project="..\build\Loom.Sdk\Loom.Shaders.props" />

  <!-- XAML → typed control-tree generator: registers UI/*.xaml as AdditionalFiles + the SUIsei.SourceGen analyzer,
       so the interactive UI demo's page compiles to a typed tree + x:Bind/event glue (same wiring as the sandbox). -->
  <Import Project="..\external\SUIsei\build\SUIsei.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Marks the browser build so demo source shared (linked) from the sandbox can compile out the few desktop-only
         bits — chiefly the Dear ImGui debug panels, whose native library the browser build doesn't reference. -->
    <DefineConstants>$(DefineConstants);LOOM_WEB</DefineConstants>
    <!-- Drop the ICU database: the demos and SUIsei text do no culture-sensitive formatting, so invariant mode is
         behaviourally identical here and saves the multi-hundred-KB ICU payload. Set unconditionally so a debug run
         behaves the same as the shipped build. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Release/publish shipping build: compile the engine + demo hot paths to native WebAssembly (the Mono interpreter
       stays as the fallback for anything AOT can't cover) for game-grade frame times, and relink the runtime with the
       unused ICALL/managed surface stripped. AOT roughly doubles the .wasm download but is the lever that makes the
       real render loop fast; keep it off for debug builds so the inner-loop build stays quick. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Hand-ported demos reuse the sandbox's shaders verbatim, compiled to WGSL and embedded under
         "Loom.Web.Shaders." (the host's ShaderResolver resolves them). Only WGSL is needed in the browser. -->
    <LoomShaderSourceDir>$(MSBuildProjectDirectory)\..\Loom.Sandbox\Shaders</LoomShaderSourceDir>
    <LoomShaderOutputMode>Embed</LoomShaderOutputMode>
    <LoomEmitDxil>false</LoomEmitDxil>
    <LoomEmitWgsl>true</LoomEmitWgsl>
  </PropertyGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <!-- The browser host references the WebGPU backend (and, transitively, the neutral engine layers). All are
       pure-managed net10.0 assemblies, so they link into the WASM app unchanged. -->
  <ItemGroup>
    <ProjectReference Include="..\Loom.Backend.WebGPU\Loom.Backend.WebGPU.csproj" />
    <ProjectReference Include="..\Loom.Core\Loom.Core.csproj" />
    <ProjectReference Include="..\Loom.Graph\Loom.Graph.csproj" />
    <ProjectReference Include="..\Loom.Assets\Loom.Assets.csproj" />
    <ProjectReference Include="..\Loom.Concepts\Loom.Concepts.csproj" />
    <!-- The SUIsei UI runtime (retained control tree + compositor, NativeAOT-clean, pure managed) and its
         backend-neutral engine bridge (UIPainter, public-API-only). Both link into the WASM app unchanged, so the
         browser drives a real UIHost exactly as the desktop sandbox does. -->
    <ProjectReference Include="..\Loom.UI.SUIsei\Loom.UI.SUIsei.csproj" />
    <ProjectReference Include="..\external\SUIsei\SUIsei\SUIsei.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The game-UI shader lives with its integration (Loom.UI.SUIsei/Shaders); pull it into this app's WGSL
         emission so it embeds as "Loom.Web.Shaders.ui.wgsl" beside the demo shaders. It resolves the same
         loom_platform.module.slang include the sandbox shaders do (LoomShaderIncludeDir is already set). -->
    <LoomSlangEntry Include="..\Loom.UI.SUIsei\Shaders\ui.slang" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reusable graph fragments the sandbox authors — shared verbatim by linking (not copying) the source, so the
         browser demos can't drift from the desktop originals. These are pure Loom.Core/Graph code (no host coupling),
         so they compile into the WASM assembly unchanged under their own Loom.Sandbox.Demos namespace. -->
    <Compile Include="..\Loom.Sandbox\Demos\BloomGraph.cs" Link="Demos\Shared\BloomGraph.cs" />
    <Compile Include="..\Loom.Sandbox\Cascades.cs" Link="Demos\Shared\Cascades.cs" />
    <Compile Include="..\Loom.Sandbox\DayNight.cs" Link="Demos\Shared\DayNight.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\DemoSun.cs" Link="Demos\Shared\DemoSun.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\SandboxVertexLayouts.cs" Link="Demos\Shared\SandboxVertexLayouts.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\SpriteInstance.cs" Link="Demos\Shared\SpriteInstance.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\Light2DInstance.cs" Link="Demos\Shared\Light2DInstance.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\BallAtlas.cs" Link="Demos\Shared\BallAtlas.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\SpinnerAtlas.cs" Link="Demos\Shared\SpinnerAtlas.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\SparkAtlas.cs" Link="Demos\Shared\SparkAtlas.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\TileAtlas.cs" Link="Demos\Shared\TileAtlas.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\CastleBackdrop.cs" Link="Demos\Shared\CastleBackdrop.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\GuardKnight.cs" Link="Demos\Shared\GuardKnight.cs" />
    <!-- The demo scaffolding shared with the sandbox: the shared-resource carrier, geometry builders, the per-draw
         uniform block, the mesh-draw helper, and the graph helpers (its Dear ImGui HUD is #if'd out for the browser). -->
    <Compile Include="..\Loom.Sandbox\Demos\IDemo.cs" Link="Demos\Shared\IDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\DemoScene.cs" Link="Demos\Shared\DemoScene.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\DemoCamera.cs" Link="Demos\Shared\DemoCamera.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\Geometry.cs" Link="Demos\Shared\Geometry.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\PerDraw.cs" Link="Demos\Shared\PerDraw.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\DemoDraw.cs" Link="Demos\Shared\DemoDraw.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\DemoGraph.cs" Link="Demos\Shared\DemoGraph.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\DebugSlider.cs" Link="Demos\Shared\DebugSlider.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\DemoShell.cs" Link="Demos\Shared\DemoShell.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The demos themselves, shared verbatim with the sandbox (one IDemo per file). The browser host (Program.cs,
         WebGallery) drives them exactly as the desktop launcher does; ImGui debug panels are #if'd out for the browser
         and asset loads route through DemoScene.Asset (embedded resources here, files on desktop). -->
    <Compile Include="..\Loom.Sandbox\Demos\CubeLightingDemo.cs" Link="Demos\CubeLightingDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\ParticlesDemo.cs" Link="Demos\ParticlesDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\HighlightingDemo.cs" Link="Demos\HighlightingDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\BloomDemo.cs" Link="Demos\BloomDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\TonemappingDemo.cs" Link="Demos\TonemappingDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\SsaoDemo.cs" Link="Demos\SsaoDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\CascadedShadowsDemo.cs" Link="Demos\CascadedShadowsDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\SkinningDemo.cs" Link="Demos\SkinningDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\GltfDemo.cs" Link="Demos\GltfDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\UIInteractiveDemo.cs" Link="Demos\UIInteractiveDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\UIGroupOpacityDemo.cs" Link="Demos\UIGroupOpacityDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\FullReferenceDemo.cs" Link="Demos\FullReferenceDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\InWorldUIDemo.cs" Link="Demos\InWorldUIDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\Debug2DDemo.cs" Link="Demos\Debug2DDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\FoliageDemo.cs" Link="Demos\FoliageDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\InstancingDemo.cs" Link="Demos\InstancingDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\Lighting2DDemo.cs" Link="Demos\Lighting2DDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\NightGladeDemo.cs" Link="Demos\NightGladeDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\NormalMappingDemo.cs" Link="Demos\NormalMappingDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\ParallaxDemo.cs" Link="Demos\ParallaxDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\PixelArtCastleDemo.cs" Link="Demos\PixelArtCastleDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\PixelArtDemo.cs" Link="Demos\PixelArtDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\RuinsDemo.cs" Link="Demos\RuinsDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\ShadowsDemo.cs" Link="Demos\ShadowsDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\SkyDayNightDemo.cs" Link="Demos\SkyDayNightDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\SpikeDemo.cs" Link="Demos\SpikeDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\SpriteAnimationDemo.cs" Link="Demos\SpriteAnimationDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\SpritesDemo.cs" Link="Demos\SpritesDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\StylizedDemo.cs" Link="Demos\StylizedDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\TilemapDemo.cs" Link="Demos\TilemapDemo.cs" />
    <Compile Include="..\Loom.Sandbox\Demos\ToonDemo.cs" Link="Demos\ToonDemo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Demo assets embedded into the WASM assembly (no filesystem in the browser), resolved by logical name.
         DemoScene.Asset callers pass a relative desktop-style path (e.g. "kenney/castle/wall.glb"); WebAssets.Load
         dot-joins it the same way these logical names are dot-separated, so both hosts address an asset identically. -->
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\rigged_bar.glb" LogicalName="Loom.Web.Assets.rigged_bar.glb" />
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\cube.gltf" LogicalName="Loom.Web.Assets.cube.gltf" />
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\brick_albedo.png" LogicalName="Loom.Web.Assets.brick_albedo.png" />
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\brick_normal.png" LogicalName="Loom.Web.Assets.brick_normal.png" />
    <!-- The Kenney castle kit (Night Glade's tree ring; Ancient Ruins' walls/towers/rocks/stairs/trees), all
         re-packed to embed their shared colormap texture (the original files referenced it by an external relative
         URI, which only a file-based loader can resolve — see GltfLoader.LoadGlb's doc comment). -->
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\kenney\castle\Textures\colormap.png" LogicalName="Loom.Web.Assets.kenney.castle.Textures.colormap.png" />
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\kenney\castle\rocks-large.glb" LogicalName="Loom.Web.Assets.kenney.castle.rocks-large.glb" />
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\kenney\castle\rocks-small.glb" LogicalName="Loom.Web.Assets.kenney.castle.rocks-small.glb" />
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\kenney\castle\stairs-stone.glb" LogicalName="Loom.Web.Assets.kenney.castle.stairs-stone.glb" />
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\kenney\castle\tower-square-arch.glb" LogicalName="Loom.Web.Assets.kenney.castle.tower-square-arch.glb" />
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\kenney\castle\tower-square-base.glb" LogicalName="Loom.Web.Assets.kenney.castle.tower-square-base.glb" />
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\kenney\castle\tower-square-mid.glb" LogicalName="Loom.Web.Assets.kenney.castle.tower-square-mid.glb" />
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\kenney\castle\tower-square-top.glb" LogicalName="Loom.Web.Assets.kenney.castle.tower-square-top.glb" />
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\kenney\castle\tree-large.glb" LogicalName="Loom.Web.Assets.kenney.castle.tree-large.glb" />
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\kenney\castle\wall-corner.glb" LogicalName="Loom.Web.Assets.kenney.castle.wall-corner.glb" />
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\kenney\castle\wall.glb" LogicalName="Loom.Web.Assets.kenney.castle.wall.glb" />
    <EmbeddedResource Include="..\Loom.Sandbox\Assets\kenney\characters\character_animated.glb" LogicalName="Loom.Web.Assets.kenney.characters.character_animated.glb" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hermetic slangc for compiling the demo shaders to WGSL (build-machine only). -->
    <PackageReference Include="Slang.Sdk" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="compile;runtime" />
    <!-- Source-gen MVVM for the demo shell's per-demo debug panels (shared with the sandbox via linked demo files). -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <Import Project="..\build\Loom.Sdk\Loom.Shaders.targets" />

  <!-- Registers UI/*.xaml as AdditionalFiles for the SUIsei.SourceGen analyzer (imported after the body so the
       source dir is set). -->
  <Import Project="..\external\SUIsei\build\SUIsei.targets" />

</Project>
