<ContentControl xmlns="https://github.com/AtomicBlom/Vysara/ui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Loom.Web.UI.UIInteractiveView"
        HorizontalAlignment="Left" VerticalAlignment="Top"
        Width="380" Height="230">
    <Border CornerRadius="16" BorderThickness="2" BorderBrush="#78B4FF" Margin="24,24,0,0" Padding="20,16,20,16">
		<StackPanel Orientation="Vertical">
			<TextBlock x:Name="TitleLabel" FontSize="18" Text="MU3 — Focus + Styles" />
			<TextBlock x:Name="StatusLabel" FontSize="22" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
			<Button x:Name="IncrementButton" HorizontalAlignment="Left" Width="160" Height="44"
Content="Increment" Click="{x:Bind OnIncrementClick}" />
			<Button x:Name="ResetButton" HorizontalAlignment="Left" Width="160" Height="44"
Content="Reset" Click="{x:Bind OnResetClick}" />
		</StackPanel>
    </Border>
</ContentControl>
