<Project>

  <!--
    The demo gallery on Android: an APK running Kaldra.Gallery's GalleryApp (the gallery without the desktop sandbox's
    ImGui dev tools) on the Android host, Vulkan only.
        dotnet build Kaldra.Sandbox.Android -t:Run      → build, install and start it on the connected device
    The gallery's shaders are embedded in its assembly (KaldraEmbedSpirv) and its models and textures are packed into the
    APK as Android assets, since an APK has no folder beside the app. Kept out of BinaryVibrance.Kaldra.slnx (in BinaryVibrance.Kaldra.Android.slnx) so
    the desktop build never needs the android workload.
  -->

  <PropertyGroup>
    <UseVulkan>true</UseVulkan>
    <UseDirectX12>false</UseDirectX12>
    <UseWebGPU>false</UseWebGPU>
    <UseVysara>true</UseVysara>
    <UseImGui>false</UseImGui>
  </PropertyGroup>

  <!-- Where the engine comes from (build/Sources.props), before Kaldra's SDK, which is the engine's -->
  <Import Project="..\build\Sources.props" />
  <Import Project="$(KaldraSource)build\BinaryVibrance.Kaldra.Sdk\Sdk\Sdk.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-android</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Kaldra.Sandbox.Android</RootNamespace>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <ApplicationId>com.atomicblom.kaldra.gallery</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- arm64 for phones; x64 for an emulator on an x64 machine. -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kaldra.Gallery\Kaldra.Gallery.csproj" />
  </ItemGroup>

  <!-- The gallery's models and textures, at the root of the APK's assets under their paths in Kaldra.Gallery/Assets. -->
  <ItemGroup>
    <AndroidAsset Include="..\Kaldra.Gallery\Assets\**" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="$(KaldraSource)build\BinaryVibrance.Kaldra.Sdk\Sdk\Sdk.targets" />

</Project>
