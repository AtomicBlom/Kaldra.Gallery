<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:label="Kaldra Gallery" android:allowBackup="false" />
	<!-- Kaldra's Vulkan backend needs Vulkan 1.3 (0x00403000); a store keeps the app off devices without it. -->
	<uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="true" />
</manifest>
